{
    "name": "diephp/laravel-resources-typescript",
    "description": "Generate TypeScript interfaces and type aliases from Laravel JsonResource classes, including enum support",
    "type": "library",
    "keywords": [
        "generate",
        "laravel",
        "laravel-package",
        "laravel-resource",
        "jsonresource",
        "resources",
        "api",
        "codegen",
        "typescript",
        "interfaces",
        "types",
        "typescript-generator",
        "laravel-typescript",
        "php-enum",
        "enum"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Anatoly Astapov",
            "email": "anatoly.astapov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.4"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.0",
        "laravel/framework": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "suggest": {
        "laravel/framework": "Laravel 9 or newer, only needed for the artisan command and the service provider"
    },
    "autoload": {
        "psr-4": {
            "DiePHP\\LaravelResourcesTypescript\\": "src/",
            "DiePHP\\Tests\\Examples\\": "tests/Examples/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DiePHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "audit-deps": [
            "@composer audit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "DiePHP\\LaravelResourcesTypescript\\Providers\\LaravelResourcesTypescriptProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
